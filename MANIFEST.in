include LICENSE
include README.md
include THIRD_PARTY_LICENSES.md
include .github/scripts/installHDF5.sh
recursive-include src/consenrich *.pyx *.pxd *.h
recursive-include src/consenrich/data *.sizes *.json
prune tests
prune docs/build
prune build
prune dist
prune output
prune tmp
global-exclude __pycache__ *.py[cod] .DS_Store .Rhistory *~
global-exclude *.so *.dylib *.dll *.o *.a
global-exclude .git .gitignore .gitattributes .gitmodules .cirrus.yml
prune vendor
prune src/consenrich/native
exclude src/consenrich/*.c
exclude HTSLIB_LICENSE.txt
exclude HTSCODECS_LICENSE.md
